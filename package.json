{
  "name": "vue-json-query-builder",
  "version": "1.0.1",
  "description": "A Vue 3 component for building nested AND/OR queries as JSON.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-json-query-builder.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "module": "./dist/vue-json-query-builder.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afineedge/vue-json-query-builder.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "query",
    "query-builder",
    "json"
  ],
  "author": "Eric Edgerton",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/afineedge/vue-json-query-builder/issues"
  },
  "homepage": "https://github.com/afineedge/vue-json-query-builder#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
